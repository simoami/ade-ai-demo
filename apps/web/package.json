{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "biome format --write .",
    "check:agent": "node scripts/check-agent.mjs",
    "check": "biome check .",
    "test": "node --experimental-strip-types --test lib/server/*.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@repo/ai": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/ui": "workspace:*",
    "@vercel/oidc": "catalog:",
    "@vercel/otel": "catalog:",
    "eve": "catalog:",
    "next": "16.4.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#lib/*": "./lib/*.ts"
  }
}