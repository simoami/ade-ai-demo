{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "domains": {
      "next": "all",
      "react": "all"
    },
    "rules": {
      "style": {
        "useComponentExportOnlyModules": {
          "level": "warn",
          "options": {
            "allowExportNames": ["metadata"]
          }
        }
      },
      "nursery": {
        "useReactCompiler": "error"
      },
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  }
}
