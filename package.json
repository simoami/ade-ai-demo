{
  "name": "ade-ai-demo",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "eval": "pnpm --filter @repo/ai eval",
    "test": "turbo run test",
    "check:agent": "pnpm --filter web check:agent",
    "check": "biome check .",
    "workflows": "WORKFLOW_TARGET_WORLD=local WORKFLOW_LOCAL_DATA_DIR=packages/ai/.eve/.workflow-data workflow inspect runs --web",
    "eval:ocr": "pnpm --filter @repo/ai eval ocr"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@workflow/cli": "5.1.0",
    "eve": "catalog:",
    "turbo": "^2.11.11"
  }
}
