{
  "name": "ade-ai-demo",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "dev:eve": "turbo run dev:eve --filter=@repo/ai",
    "eval": "turbo run eval --filter=@repo/ai",
    "test": "turbo run test",
    "check:agent": "pnpm --filter web check:agent",
    "check": "biome check ."
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "@biomejs/biome": "catalog:"
  }
}
