{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "domains": {
      "react": "all"
    }
  },
  "overrides": [
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "performance": { "noJsxPropsBind": "off" },
          "style": { "useComponentExportOnlyModules": "off" },
          "suspicious": { "noLeakedRender": "off" }
        }
      }
    }
  ]
}
