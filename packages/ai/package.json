{
  "name": "@repo/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "eve dev --port 8000 --no-ui --no-default-extensions",
    "build": "eve build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "test": "node --experimental-strip-types --test tests/*.test.ts src/**/*.test.ts",
    "eval": "node --env-file-if-exists=.env.local evals/run.ts",
    "format": "biome format --write .",
    "check": "biome check .",
    "seed:samples": "node --env-file-if-exists=.env.local scripts/seed-samples.ts",
    "bench:render": "node scripts/bench-render.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@hyzyla/pdfium": "^3.0.0",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/storage": "workspace:*",
    "ai": "^7.0.173",
    "eve": "catalog:",
    "reductoai": "0.20.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "catalog:",
    "braintrust": "catalog:",
    "pdf-lib": "^1.17.1",
    "typescript": "catalog:"
  },
  "exports": {
    "./review-action": "./src/workflows/ingest-document/review-action.ts"
  },
  "imports": {
    "#agent/*": "./agent/*.ts",
    "#*": "./src/*.ts",
    "#evals/*": "./evals/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
